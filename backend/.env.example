# ─────────────────────────────────────────────
# Azure Vision (sma-vision-service)
# ─────────────────────────────────────────────
AZURE_VISION_ENDPOINT=https://sma-vision-service.koreacentral.cognitiveservices.azure.com
AZURE_VISION_KEY=

# ─────────────────────────────────────────────
# Azure Document Intelligence (sma-doc-intelligence)
# ─────────────────────────────────────────────
AZURE_DOC_INTEL_ENDPOINT=https://sma-doc-intelligence.cognitiveservices.azure.com
AZURE_DOC_INTEL_KEY=

# ─────────────────────────────────────────────
# Azure OpenAI (smaopenai)
# Get deployment names from Azure AI Foundry > Deployments
# ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://smaopenai.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=chat-model
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding-model

# ─────────────────────────────────────────────
# Azure AI Search (sma-search-service)
# ─────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://sma-search-service.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=media-knowledge-index

# ─────────────────────────────────────────────
# Azure Blob Storage (smamediastorage)
# Get the full connection string from: Storage account > Access keys
# ─────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads

# ─────────────────────────────────────────────
# Azure AI Speech (sma-speech-service) — voice input/output
# ─────────────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# ─────────────────────────────────────────────
# Azure Cosmos DB (sma-cosmos-db) — chat history storage
# ─────────────────────────────────────────────
AZURE_COSMOS_URI=https://sma-cosmos-db.documents.azure.com:443/
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=smart-media-agent
AZURE_COSMOS_CONTAINER=conversations
